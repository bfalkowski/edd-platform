ANTHROPIC_API_KEY=sk-ant-...
EDD_ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional when running local Langfuse.
LANGFUSE_BASE_URL=http://localhost:3001
LANGFUSE_PUBLIC_KEY=pk-lf-local-demo
LANGFUSE_SECRET_KEY=sk-lf-local-demo
EDD_PLATFORM_LANGFUSE_DATASET_SYNC=planned
EDD_PLATFORM_LANGFUSE_SCORE_SYNC=planned
EDD_PLATFORM_LANGFUSE_COMMENT_SYNC=planned

# Optional when using a non-default local Postgres.
EDD_PLATFORM_DATABASE_URL=postgresql://edd_platform:edd_platform@127.0.0.1:15432/edd_platform
